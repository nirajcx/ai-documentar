# ==============================================================================
# AI-Documenter - Backend Environment Template
# ==============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# PostgreSQL: default password admin123
DATABASE_URL=postgresql+asyncpg://postgres:admin123@192.168.1.3:5432/ai_documenter
REDIS_URL=redis://192.168.1.3:6379/0

# MinIO S3 Object Storage
S3_ENDPOINT_URL=http://192.168.1.3:9000
S3_ACCESS_KEY_ID=admin
S3_SECRET_ACCESS_KEY=admin123
S3_BUCKET=documentar
S3_REGION=us-east-1

# Ollama running on MacBook Docker (IP: 192.168.1.4)
OLLAMA_BASE_URL=http://192.168.1.4:11434
