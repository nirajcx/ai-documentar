# ==============================================================================
# AI-Documenter - Backend Environment Template
# ==============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# PostgreSQL: local PostgreSQL (or Docker)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_documenter
REDIS_URL=redis://localhost:6379/0

# MinIO S3 Object Storage (localhost:9000)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=documentar
S3_REGION=us-east-1

# Ollama running locally
OLLAMA_BASE_URL=http://localhost:11434

# Chat provider: Groq (cloud) or Ollama (local). Embeddings remain independent.
CHAT_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low
GROQ_MAX_COMPLETION_TOKENS=2048
OLLAMA_CHAT_MODEL=llama3.1:8b

# Enable only after migrations, private S3 bucket, Ollama and worker/beat smoke tests.
RAG_ENABLED=false
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=8
RAG_MAX_DISTANCE=0.65
DOCUMENT_MAX_COUNT=100
DOCUMENT_QUOTA_BYTES=524288000

# Redis-backed limits; production deployments should enable this.
RATE_LIMIT_ENABLED=true
