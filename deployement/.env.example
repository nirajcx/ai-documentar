# ==============================================================================
# AI-Documenter - Deployment Environment Configuration
# ==============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin123
POSTGRES_DB=ai_documenter
DATABASE_URL=postgresql+asyncpg://postgres:admin123@postgres:5432/ai_documenter
REDIS_URL=redis://redis:6379/0

NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
CORS_ORIGINS=["http://localhost:3000"]

# MinIO
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=admin123
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://192.168.1.3:9000
S3_ACCESS_KEY_ID=admin
S3_SECRET_ACCESS_KEY=admin123
S3_BUCKET=documentar
S3_REGION=us-east-1

# Ollama on MacBook in Docker (Mac IP: 192.168.1.4)
OLLAMA_BASE_URL=http://192.168.1.4:11434

# Port bindings
BIND_ADDRESS=0.0.0.0
WEB_PORT=3000
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

# Chat provider: Groq (cloud) or Ollama (local). Embeddings remain independent.
CHAT_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low
GROQ_MAX_COMPLETION_TOKENS=2048
OLLAMA_CHAT_MODEL=llama3.1:8b

# Enable only after migrations, private S3 bucket, Ollama and worker/beat smoke tests.
RAG_ENABLED=false
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=8
RAG_MAX_DISTANCE=0.65
DOCUMENT_MAX_COUNT=100
DOCUMENT_QUOTA_BYTES=524288000

# Redis-backed limits; production deployments should enable this.
RATE_LIMIT_ENABLED=true
