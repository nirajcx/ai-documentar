# Ubuntu production-target scaffold. Copy to .env.ubuntu (never commit that file).
# REQUIRED: paste output of `openssl rand -hex 24` below. Hex needs no URL escaping.
POSTGRES_USER=documentar
POSTGRES_PASSWORD=
POSTGRES_DB=documentar
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
REDIS_URL=redis://redis:6379/0

# Default: access over SSH tunnel; does not conflict with existing 80/8000 services.
# For direct trusted LAN access, set BIND_ADDRESS to the Ubuntu LAN IP and replace
# localhost in NEXT_PUBLIC_API_URL / CORS_ORIGINS with that same address.
BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
API_PORT=8001
NEXT_PUBLIC_API_URL=http://localhost:8001/api/v1
CORS_ORIGINS=["http://localhost:3000"]

# Existing lab-minio publishes port 9000 on Ubuntu. No new MinIO is created.
S3_ENDPOINT_URL=http://host.docker.internal:9000
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=documentar
S3_REGION=us-east-1
# REPLACE with your Mac's LAN/VPN IP before model integration. No calls happen yet.
OLLAMA_BASE_URL=http://REPLACE_WITH_MAC_IP:11434

# Chat provider: Groq (cloud) or Ollama (local). Embeddings remain independent.
CHAT_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low
GROQ_MAX_COMPLETION_TOKENS=2048
OLLAMA_CHAT_MODEL=llama3.1:8b

# Enable only after migrations, private S3 bucket, Ollama and worker/beat smoke tests.
RAG_ENABLED=false
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=8
RAG_MAX_DISTANCE=0.65
DOCUMENT_MAX_COUNT=100
DOCUMENT_QUOTA_BYTES=524288000

# Redis-backed limits; production deployments should enable this.
RATE_LIMIT_ENABLED=true

# Optional web search: create a server-side key at https://app.tavily.com
WEB_SEARCH_ENABLED=false
TAVILY_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_SECONDS=15
